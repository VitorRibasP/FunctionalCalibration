install.packages("usethis")
library(fracdiff)
library(MCMCpack)
library(wavethresh)
funcao1 <- function(x) sin(5*x)*exp(-x^2)
funcao2 <- function(x) 1.2*log(1 + 9*x)/log(10)*exp(-x)
set.seed(123)
dados_spl <- gerador_dados(1024, list(funcao1, funcao2), 4900, "Normal", 0)
#Gerador de dados funcionais agregados
gerador_dados <- function(n, funcoes, SNR, modelo, param, m = 100) {
l <- length(funcoes)
x <- seq(0, 1, length.out = n)
dados <- matrix(0, nrow = n, ncol = m)
#Gerando os pesos
y <- t(rdirichlet(m, alpha = rep(1, l)))
#Agregando Funções
for(i in 1:l) {
dados <- dados + sweep(
matrix(rep(sapply(x, funcoes[[i]]), m), nrow = n, ncol = m)
, 2, y[i,], `*`)
}
#Adicionando os Erros
if(modelo == "AR") {
sd <- sqrt((49*(1-param^2))/(SNR))
for (i in 1:m) {
dados[,i] <- dados[,i] + arima.sim(n = n, list(ar = param), sd = sd)
}
} else if(modelo == "ARFIMA") {
sd <- sqrt((49*gamma(1 - param)^2)/(SNR*gamma(1 - 2*param)))
for (i in 1:m) {
dados[,i] <- dados[,i] + fracdiff.sim(n = n, d = param, sd = sd)$series
}
} else if(modelo == "Normal") {
sd <- sqrt(49/SNR)
for (i in 1:m) {
dados[,i] <- dados[,i] + rnorm(n, mean = 0, sd = sd)
}
}
#Retornando Objeto
return(list("dados" = dados, "y" = y))
}
set.seed(123)
dados_spl <- gerador_dados(1024, list(funcao1, funcao2), 4900, "Normal", 0)
#functional_calibration_splines(a$dados, a$y, seq(0,1, length.out = 1024))
x <- seq(0,1, length.out = 1024)
simulated_data_spl <- list(
"data" = dados_spl$dados,
"weights" = dados_spl$y,
"x" = x,
"alphas" = matrix(c(sapply(x, funcao1), sapply(x, funcao2)), ncol = 2)
)
save(simulated_data_spl, file = "simulated_data_spl.rda")
